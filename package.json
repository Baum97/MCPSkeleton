{
  "name": "create-mcp-server",
  "version": "0.0.1",
  "description": "Scaffold a Model Context Protocol server in seconds.",
  "type": "module",
  "bin": {
    "create-mcp-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rimraf dist",
    "test": "vitest run",
